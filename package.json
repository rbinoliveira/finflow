{
  "name": "finflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "NODE_OPTIONS='--no-warnings' ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx && echo '✅ Lint concluído com sucesso!'",
    "lint:fix": "NODE_OPTIONS='--no-warnings' ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx --fix && echo '✅ Lint:fix concluído com sucesso!'",
    "typecheck": "tsc --noEmit",
    "firebase:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "env:check": "./scripts/env-files-check.sh",
    "env:sync": "./scripts/vercel-env-sync.sh",
    "env:sync:preview": "./scripts/vercel-env-sync.sh .env.local preview",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rbinflow/eslint-config": "^1.1.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.36.0",
    "firebase-tools": "^15.28.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.5.2"
}
